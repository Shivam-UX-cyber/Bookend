# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (Used for CORS and Cookie configuration)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas connection string)
# Replace with your actual Atlas cluster connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_book_exchange?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong, 64+ char random string in production)
JWT_SECRET=your_jwt_super_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Cookie Security Configuration (Optional overrides)
# In production with cross-origin frontend (Vercel) & backend (Render), defaults to:
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
# In local development, defaults to COOKIE_SAME_SITE=lax and COOKIE_SECURE=false.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Email Delivery Configuration (Resend HTTPS API)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender Address
# For development/testing without a verified domain, Resend provides:
# EMAIL_FROM=Campus Book Exchange <onboarding@resend.dev>
# Note: onboarding@resend.dev only allows sending to the email of the Resend account owner.
# For production with your own verified domain, configure:
# EMAIL_FROM=Campus Book Exchange <no-reply@yourdomain.com>
EMAIL_FROM=Campus Book Exchange <onboarding@resend.dev>

# Optional Protected Remote Diagnostics Secret (Generate a 32+ character random secret)
# DIAGNOSTIC_KEY=your_diagnostic_secret_key_min_32_characters_long

