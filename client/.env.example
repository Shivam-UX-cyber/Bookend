# Frontend Environment Variables (Vite)
# Local development default:
VITE_API_BASE_URL=http://localhost:5000

# Production on Render Web Service (via Docker image):
# Vite bakes VITE_* variables into static JavaScript assets during `npm run build`.
# When building Docker images, pass this as a build-arg:
# docker build --build-arg VITE_API_BASE_URL=https://bookend-backend-7y88.onrender.com -t bookend-frontend ./client
# Default in client/Dockerfile is pre-configured to: https://bookend-backend-7y88.onrender.com
# (Note: Do not include trailing slashes; the application automatically strips them if present)
